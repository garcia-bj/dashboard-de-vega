# ============================================================
#  Cookio — .env de ejemplo
#  Copia este archivo a .env y edita los valores
# ============================================================

# ──── Base de datos (PostgreSQL) ────
POSTGRES_USER=cookio
POSTGRES_PASSWORD=cookio_secret
POSTGRES_DB=cookio

# ──── Conexion del backend a la DB ────
DATABASE_URL=postgresql+asyncpg://cookio:cookio_secret@postgres:5432/cookio

# ──── Redis ────
REDIS_URL=redis://redis:6379/0

# ──── General Backend ────
APP_NAME=Cookio
DEBUG=false
SECRET_KEY=GENERA_CON_openssl_rand_hex_32

# ──── Usuario admin (se crea automaticamente al iniciar) ────
ADMIN_EMAIL=tu@email.com
ADMIN_PASSWORD=tu_contraseña_segura

# ──── Storage (RustFS S3 local o externo) ────
STORAGE_BACKEND=s3
STORAGE_S3_BUCKET=cookio-media
STORAGE_S3_ENDPOINT=http://rustfs:9000
STORAGE_S3_PUBLIC_URL=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=cookio
STORAGE_S3_SECRET_KEY=cookio_secret

# ──── n8n ────
N8N_IMG_GENERATION_URL=https://TU_N8N/webhook/img_asd
N8N_WEBHOOK_URL=http://n8n:5678
N8N_IMAGE_GEN_WEBHOOK=/webhook/image-generation
N8N_PUBLISH_WEBHOOK=/webhook/auto-publish

# ──── AI APIs ────
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-pro

# ──── Video (Kie.ai) ────
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_VIDEO_MODEL=bytedance/seedance-2
APP_PUBLIC_URL=https://api.TU_DOMINIO.com

# ──── Meta (Facebook / Instagram) ────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.TU_DOMINIO.com/api/social/meta/callback

# ──── CORS ────
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ──── Frontend ────
NEXT_PUBLIC_API_URL=http://localhost:8000
